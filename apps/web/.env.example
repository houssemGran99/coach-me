# MongoDB (recommended). When MONGODB_URI is set it is used instead of Supabase and visitors are guests.
MONGODB_URI=
MONGODB_DB=coach
# Signs the guest cookie. Use a long random value, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# Supabase (alternative, email magic links)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Model provider: gemini or anthropic (guessed from the key when empty). LLM_MODEL defaults to gemini-2.5-flash / claude-sonnet-5-5.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
FREE_LIBRARY_LIMIT=20
DAILY_GENERATION_LIMIT=20
DAILY_SHARE_LIMIT=30
# Public origin used in magic links and share URLs (optional; derived from the request when empty).
NEXT_PUBLIC_SITE_URL=
# Local development only: in-memory data, any email signs in, mock model. Refused in production builds.
MOCK_BACKEND=
# Templates start as "pending" review. Set to 0 to exclude them from generated sessions until reviewed.
ALLOW_PENDING_TEMPLATES=1

# German is the default language. Set to 1 to pick the language from the browser's Accept-Language instead.
NEGOTIATE_LANGUAGE=
