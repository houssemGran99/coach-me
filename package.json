{
  "name": "mourabbi",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm templates:bundle && pnpm --filter @mourabbi/web dev",
    "build": "pnpm templates:bundle && pnpm --filter @mourabbi/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @mourabbi/web test:e2e",
    "templates:validate": "tsx scripts/validate-templates.ts",
    "templates:preview": "tsx scripts/preview-templates.ts",
    "templates:bundle": "tsx scripts/bundle-templates.ts",
    "videos:export": "tsx scripts/export-videos.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@mourabbi/schemas": "workspace:*",
    "@mourabbi/animation": "workspace:*"
  }
}
