  "name": {
    "fr": "Chat avec ballon",
    "en": "Tag with a ball",
    "ar": "لعبة المطاردة بالكرة"
  },
  "organisation": {
    "fr": "Carré de 20 m. Tout le monde conduit un ballon. Un ou deux poursuiveurs en chasuble conduisent aussi. Un poursuiveur qui touche un joueur de la main l'envoie faire 5 touches sur place, puis il reprend le jeu. Changer de poursuiveur toutes les minutes.",
    "en": "20 m square. Everyone dribbles a ball. One or two taggers wear bibs and also dribble. A tagger who touches a player with a hand sends them to do 5 touches on the spot, then they rejoin the game. Change taggers every minute.",
    "ar": "مربع 20 م. يراوغ الجميع بكراتهم. مطارد أو اثنان يرتديان صدرية ويراوغان أيضًا. إذا لمس المطارد لاعبًا بيده يؤدي اللاعب 5 لمسات في مكانه ثم يعود إلى اللعب. بدّل المطاردين كل دقيقة."
  },
  "coachingPoints": {
    "fr": [
      "Garder le ballon proche en changeant de rythme",
      "Regarder derrière soi pour repérer le poursuiveur",
      "Utiliser feintes et demi-tours pour s'échapper"
    ],
    "en": [
      "Keep the ball close while changing speed",
      "Look over your shoulder for the tagger",
      "Use feints and quick turns to escape"
    ],
    "ar": [
      "أبقِ الكرة قريبة وغيّر السرعة",
      "انظر خلفك لتراقب المطارد",
      "استعمل المراوغات والدوران السريع للإفلات"
    ]
  },
  "variants": [
