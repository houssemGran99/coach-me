  "organisation": {
    "en": "30 m by 20 m area with a mini goal in each corner. Two teams of three plus three neutral players who support the team in possession. Score by passing or dribbling into a corner goal. The team that loses the ball defends all four goals.",
    "fr": "Zone de 30 m sur 20 m avec un mini-but dans chaque coin. Deux équipes de trois et trois joueurs neutres qui soutiennent l'équipe en possession. On marque en passant ou en conduisant dans un but de coin. L'équipe qui perd le ballon défend les quatre buts.",
    "de": "Fläche von 30 m mal 20 m mit einem Minitor in jeder Ecke. Zwei Teams zu je drei Spielern plus drei neutrale Spieler, die das Team am Ball unterstützen. Ein Tor fällt durch Passen oder Dribbeln in ein Eckentor. Das Team, das den Ball verliert, verteidigt alle vier Tore."
  },
  "coachingPoints": {
    "en": [
      "Create width early so the ball can switch sides",
      "Support the ball carrier from 5 to 10 m",
      "Pick the corner goal furthest from the nearest defender"
    ],
    "fr": [
      "Créer de la largeur tôt pour pouvoir changer de côté",
      "Soutenir le porteur à 5-10 m",
      "Choisir le but de coin le plus éloigné du défenseur le plus proche"
    ],
    "de": [
      "Schaffe früh Breite, damit der Ball die Seite wechseln kann",
      "Unterstütze den Ballführenden aus 5 bis 10 m",
      "Wähle das Eckentor, das am weitesten vom nächsten Verteidiger entfernt ist"
    ]
  },
