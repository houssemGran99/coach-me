  "organisation": {
    "fr": "Zone de 35 m sur 30 m avec un grand but et un gardien. Quatre défenseurs en ligne compacte défendent face à trois attaquants qui font circuler le ballon. Les défenseurs coulissent ensemble selon le ballon : le plus proche presse, les autres couvrent et gardent leurs distances. Changer les défenseurs après deux minutes.",
    "en": "35 m by 30 m area with a full goal and a goalkeeper. Four defenders in a compact line defend against three attackers who pass the ball around. The defenders shift together as the ball moves: the nearest presses, the others cover and keep their distances. Rotate defenders after two minutes."
  },
  "coachingPoints": {
    "fr": [
      "Rester compacts : les quatre défenseurs à environ 10 m les uns des autres",
      "Le plus proche presse ; les autres couvrent l'espace derrière",
      "Coulisser avec le ballon et communiquer sans cesse"
    ],
    "en": [
      "Stay compact: the four defenders within about 10 m of each other",
      "The nearest defender presses; the others cover the space behind",
      "Shift as the ball moves and talk constantly"
    ]
  },
