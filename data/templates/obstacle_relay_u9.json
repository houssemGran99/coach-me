  "name": {
    "fr": "Relais de conduite en slalom",
    "en": "Dribbling slalom relay",
    "ar": "سباق تتابع المراوغة بين الأقماع"
  },
  "organisation": {
    "fr": "Deux équipes s'affrontent dans deux couloirs d'une zone de 25 m sur 15 m. Chaque joueur conduit entre trois plots de slalom, contourne le plot de fond puis revient, et passe au joueur suivant de son équipe. La première équipe qui termine gagne. Garder le contrôle : un ballon perdu oblige à repartir du dernier plot.",
    "en": "Two teams race in two lanes of a 25 m by 15 m area. Each player dribbles through three slalom cones, around the end cone and back, then passes to the next player in the team. The first team to finish wins. Keep control: a lost ball means going back to the last cone.",
    "ar": "يتسابق فريقان في ممرين داخل منطقة 25 × 15 م. يراوغ كل لاعب بين ثلاثة أقماع متعرجة ثم حول القمع الأخير ويعود، ثم يمرّر إلى اللاعب التالي في فريقه. الفريق الذي ينتهي أولًا يفوز. حافظ على التحكم: الكرة الضائعة تعني العودة إلى آخر قمع."
  },
  "coachingPoints": {
    "fr": [
      "Petites touches près des plots, plus longues en ligne droite",
      "Utiliser les deux pieds et les deux côtés du pied",
      "Passer à son coéquipier avant qu'il ne démarre"
    ],
    "en": [
      "Small touches near the cones, longer touches in the straights",
      "Use both feet and both sides of each foot",
      "Pass to your teammate before they start"
    ],
    "ar": [
      "لمسات صغيرة قرب الأقماع وأطول في المسافات المستقيمة",
      "استعمل القدمين وجانبي القدم",
      "مرّر إلى زميلك قبل أن ينطلق"
    ]
  },
